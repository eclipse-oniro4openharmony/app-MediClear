# Docker host binding. Use 0.0.0.0 for physical-phone testing on the same LAN.
BACKEND_BIND_HOST=0.0.0.0
BACKEND_BIND_PORT=18080
NODE_ENV=production

# MongoDB runtime.
MONGO_DB_NAME=mediclear
PDF_TEXT_MIN_LENGTH=300
CHUNK_SIZE=1200
CHUNK_OVERLAP=160
OCR_SERVICE_URL=http://paddleocr:8080
OCR_TIMEOUT_MS=120000

# Authentication. npm run gen-auth-secret generates and preserves this secret.
AUTH_TOKEN_SECRET=

# SMTP is required for registration verification and password reset emails.
AUTH_EMAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OpenAI-compatible chat completion endpoint.
# For local models from Docker, use host.docker.internal instead of localhost.
#
# Ollama example:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=
#
# LM Studio example:
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_MODEL=local-model
# LLM_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Legacy DeepSeek variables still work if LLM_* is not set.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
